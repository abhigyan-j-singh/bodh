# bodh secrets. `./install.sh` copies this file to .env (chmod 600); fill in BazQux and the keys the roles in config.yaml need.
# .env is never committed, and `bodh doctor` says which values are set without showing them.

# Your BazQux Reader account: the email you log in with at bazqux.com and its password.
# bodh logs in the way a reader app does (ClientLogin); there is no separate API key.
# A paid subscription is needed: the API stops answering when it lapses ("YearSubscriptionExpired").
BAZQUX_EMAIL=
BAZQUX_PASSWORD=

# The model providers. Each role in config.yaml (models.judge, models.reviewer, models.profiler,
# catch_up.model) names a model as provider/model-id; a bare id means Anthropic. Only the providers
# those roles use need a key. `bodh keys set <provider>` writes one here without showing it;
# `bodh keys` says which are set. A key may also live in the environment or, with
# `pip install bodh[keychain]`, in the system keychain (`bodh keys set <provider> --keychain`);
# the order is .env, the environment, the keychain. docs/models.md has the details.

# Anthropic, https://console.anthropic.com → API keys (the default for every role). Put a few
# dollars of credit on the account first. Judgments go through the Message Batches API by default
# (half price); if your key cannot use it, set `models.batch: false` in config.yaml.
ANTHROPIC_API_KEY=

# OpenAI, https://platform.openai.com/api-keys (openai/gpt-5-mini, say). Uses the Responses API,
# the Batch API and structured outputs.
OPENAI_API_KEY=

# Google Gemini, https://aistudio.google.com/apikey (gemini/gemini-2.5-pro, say).
GEMINI_API_KEY=

# OpenRouter, https://openrouter.ai/keys: one key for many models (openrouter/qwen/qwen3-235b, say).
# No batch API: every call at once at the listed price.
OPENROUTER_API_KEY=

# Any OpenAI-compatible service, local or self-hosted: Ollama, llama.cpp, vLLM, LM Studio. The base
# URL is what selects it (openai-compatible/llama3.3, say); the key is optional and is sent as a
# bearer token when set. With Ollama: OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1 and no
# key, and nothing leaves the machine. Without token counts from the service the spend is estimated.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional: a ping URL from https://healthchecks.io (create a check with period 30 minutes and
# grace 30 minutes; copy its URL, https://hc-ping.com/<uuid>). Every good run pings it, a failed
# run pings /fail, and an hour of silence raises an alert. Leave empty for no dead-man's switch.
HEALTHCHECK_URL=
