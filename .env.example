# bodh secrets. `./install.sh` copies this file to .env (chmod 600); fill in the four values.
# .env is never committed, and `bodh doctor` says which values are set without showing them.

# Your BazQux Reader account: the email you log in with at bazqux.com and its password.
# bodh logs in the way a reader app does (ClientLogin); there is no separate API key.
# A paid subscription is needed: the API stops answering when it lapses ("YearSubscriptionExpired").
BAZQUX_EMAIL=
BAZQUX_PASSWORD=

# An Anthropic API key from https://console.anthropic.com → API keys. The judge, the review
# and the Sunday rewrite all use it; put a few dollars of credit on the account first. Judgments
# go through the Message Batches API by default (half price); if your key cannot use it, set
# `models.batch: false` in config.yaml.
ANTHROPIC_API_KEY=

# Optional: a ping URL from https://healthchecks.io (create a check with period 30 minutes and
# grace 30 minutes; copy its URL, https://hc-ping.com/<uuid>). Every good run pings it, a failed
# run pings /fail, and an hour of silence raises an alert. Leave empty for no dead-man's switch.
HEALTHCHECK_URL=
